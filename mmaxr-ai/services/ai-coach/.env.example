# Copy to .env (untracked). Set only the providers you use.
AI_COACH_PROVIDER=anthropic        # anthropic | openai | gemini
CLAUDE_API_KEY=                    # Anthropic (ANTHROPIC_API_KEY also works)
OPENAI_API_KEY=
GEMINI_API_KEY=                    # GOOGLE_API_KEY also works
# Optional model overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-2.0-flash
# AI_COACH_REQUIRE_SESSION=false   # skip session-token check (local scripts only)
# AI_COACH_ALLOWED_ORIGINS=http://localhost:5173
# AI_COACH_ASKS_PER_MINUTE=5       # student questions per minute, per session
# Voice (spoken replies). Piper: https://github.com/rhasspy/piper, voice en_GB-jenny_dioco-medium (.onnx + .onnx.json)
# PIPER_BIN=/opt/piper/piper
# PIPER_MODEL=/opt/piper/voices/en_GB-jenny_dioco-medium.onnx
# PIPER_SAMPLE_RATE=22050          # the voice's audio.sample_rate
# LAME_BIN=lame                    # MP3 encoder
# Speech-to-text for spoken questions from browsers that cannot transcribe (audio_ask). whisper.cpp + ffmpeg.
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/opt/whisper/ggml-base.en.bin
# WHISPER_LANGUAGE=en
# WHISPER_CONCURRENCY=2            # transcriptions at once across all students
# WHISPER_THREADS=4
# FFMPEG_BIN=ffmpeg
