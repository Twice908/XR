  "transfer": {
    "scenarios": [
      {
        "id": "bile_blocked",
        "question": "A person's bile duct is blocked, so bile cannot reach the small intestine. Which food group becomes hardest to digest?",
        "options": [
          {
            "id": "carbs",
            "label": "Carbohydrates"
          },
          {
            "id": "proteins",
            "label": "Proteins"
          },
          {
            "id": "fats",
            "label": "Fats"
          },
          {
            "id": "water",
            "label": "Water"
          }
        ],
        "answer": "fats",
        "explanation": "Bile emulsifies fat globules into smaller droplets so lipase can reach them. Without bile, fat digestion is slow and incomplete."
      },
      {
        "id": "no_chewing",
        "question": "Someone swallows their food almost whole, without chewing. What is affected first?",
        "options": [
          {
            "id": "mech",
            "label": "Less mechanical breakdown and less saliva mixing, so starch digestion starts poorly"
          },
          {
            "id": "pepsin",
            "label": "Pepsin can no longer be made"
          },
          {
            "id": "bile",
            "label": "The liver stops making bile"
          },
          {
            "id": "water",
            "label": "The large intestine cannot absorb water"
          }
        ],
        "answer": "mech",
        "explanation": "Chewing breaks food into small pieces and mixes it with saliva, so salivary amylase can begin turning starch into sugars."
      },
      {
        "id": "no_acid",
        "question": "A medicine stops the stomach making hydrochloric acid. Which job is most affected?",
        "options": [
          {
            "id": "pepsin",
            "label": "Pepsin is not activated, so protein digestion slows"
          },
          {
            "id": "saliva",
            "label": "Saliva stops being made"
          },
          {
            "id": "bile",
            "label": "Bile cannot emulsify fats"
          },
          {
            "id": "villi",
            "label": "The villi stop absorbing nutrients"
          }
        ],
        "answer": "pepsin",
        "explanation": "HCl makes the stomach acidic, which activates pepsin. Without the acid, proteins are broken down far less."
      }
    ]
