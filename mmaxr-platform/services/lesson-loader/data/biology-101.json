      "animLabels": [
        "Saliva",
        "Salivary amylase (Ptyalin)",
        "Mucus",
        "Lysozyme"
      ],
      "explanation": "Three pairs of salivary glands release about 1 to 1.5 litres of saliva a day: the Parotid glands (in front of the ears), the Submandibular glands (under the jaw) and the Sublingual glands (under the tongue). Saliva is mostly water with Salivary Amylase (Ptyalin), which starts breaking starch into maltose, Mucus, which lubricates food into a soft bolus, and Lysozyme, which kills bacteria. Even the smell of food can make these glands start working.",
      "quiz": [
        {
          "id": "salivary_glands_q1",
          "prompt": "You smell freshly baked bread and your mouth waters. What are the salivary glands doing?",
          "options": [
            {
              "id": "a",
              "label": "Releasing saliva that holds amylase before any food arrives"
            },
            {
              "id": "b",
              "label": "Releasing bile to digest the bread's fat"
            },
            {
              "id": "c",
              "label": "Releasing HCl to kill bacteria"
            },
            {
              "id": "d",
              "label": "Storing saliva until you swallow"
            }
          ],
          "answer": "a",
          "explanation": "Even the smell of food starts the salivary glands, so saliva with amylase is ready for starch."
        },
        {
          "id": "salivary_glands_q2",
          "prompt": "Which enzyme in saliva starts breaking starch down?",
          "options": [
            {
              "id": "a",
              "label": "Salivary amylase"
            },
            {
              "id": "b",
              "label": "Pepsin"
            },
            {
              "id": "c",
              "label": "Lipase"
            },
            {
              "id": "d",
              "label": "Trypsin"
            }
          ],
          "answer": "a",
          "explanation": "Salivary amylase (ptyalin) turns starch into the sugar maltose."
        },
        {
          "id": "salivary_glands_q3",
          "prompt": "What does the lysozyme in saliva do?",
          "options": [
            {
              "id": "a",
              "label": "Kills bacteria that enter with food"
            },
            {
              "id": "b",
              "label": "Breaks down proteins"
            },
            {
              "id": "c",
              "label": "Emulsifies fats"
            },
            {
              "id": "d",
              "label": "Lubricates the bolus"
            }
          ],
          "answer": "a",
          "explanation": "Lysozyme is the germ-killing part of saliva. Mucus does the lubricating."
        },
        {
          "id": "salivary_glands_q4",
          "prompt": "Where are the three pairs of salivary glands found?",
          "options": [
            {
              "id": "a",
              "label": "Near the ears, under the jaw and under the tongue"
            },
            {
              "id": "b",
              "label": "In the wall of the stomach"
            },
            {
              "id": "c",
              "label": "Beside the liver"
            },
            {
              "id": "d",
              "label": "Along the small intestine"
            }
          ],
          "answer": "a",
          "explanation": "Parotid (by the ears), submandibular (under the jaw) and sublingual (under the tongue)."
        },
        {
          "id": "salivary_glands_q5",
          "prompt": "What is the job of mucus in saliva?",
          "options": [
            {
              "id": "a",
              "label": "Makes food slippery and soft so it forms a bolus that is easy to swallow"
            },
            {
              "id": "b",
              "label": "Breaks starch into maltose"
            },
            {
              "id": "c",
              "label": "Neutralises stomach acid"
            },
            {
              "id": "d",
              "label": "Absorbs glucose into blood"
            }
          ],
          "answer": "a",
          "explanation": "Mucus lubricates; it is not an enzyme."
        }
      ]
    },
