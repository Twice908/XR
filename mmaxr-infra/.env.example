# LOCAL PILOT ONLY. Replace local placeholders before use; never commit secrets.
POSTGRES_USER=mmaxr
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5432

# Default shared connection and service-owned logical databases.
POSTGRES_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_session_auth
SESSION_AUTH_DATABASE_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_session_auth
XAPI_EMITTER_DATABASE_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_xapi_emitter
SENSOR_STREAM_DATABASE_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_sensor_stream
LRS_DATABASE_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_lrs
OBJECT_STORE_DATABASE_URL=postgresql://mmaxr:change-me-local-only@localhost:5432/mmaxr_object_store
SESSION_AUTH_PORT=3001
XAPI_EMITTER_PORT=3002
SENSOR_STREAM_PORT=3003
LRS_PORT=3004
OBJECT_STORE_PORT=3005

REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379

# MinIO. Host-facing endpoint is for local apps; container-facing endpoint is
# for services running in the Compose network.
S3_ENDPOINT=http://localhost:9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=mmaxr-local
S3_SECRET_KEY=change-me-minio-local-only
S3_BUCKET=mmaxr-local
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=mmaxr-local
MINIO_SECRET_KEY=change-me-minio-local-only
MINIO_BUCKET=mmaxr-local
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
MINIO_IMAGE=quay.io/minio/aistor@sha256:60db8181b44a8d787564bd92ca8b3d57322bac959d9d6910c4c03459a6db6145
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Yet Analytics SQL LRS (xAPI base endpoint and Basic Auth credentials).
LRS_ENDPOINT=http://localhost:8080/xapi
LRS_KEY=mmaxr-local-key
LRS_SECRET=change-me-lrs-local-only
SQL_LRS_BASE_URL=http://localhost:8080/xapi
SQL_LRS_API_KEY=mmaxr-local-key
LRS_ADMIN_USER=admin
LRS_ADMIN_PASSWORD=change-me-admin-local-only
LRS_HOST_PORT=8080
LRSQL_POSTGRES_PASSWORD=change-me-lrs-postgres-local-only

