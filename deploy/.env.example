# Copy to deploy/.env (git-ignored). NEVER commit real values.
API_HOST=api.example.com

# --- Supabase Postgres (Project > Connect > "Session pooler" URI; includes ?uselibpqcompat=true&sslmode=require) ---
DATABASE_URL='postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require'

# --- Supabase Storage via S3 protocol (Project Settings > Storage > S3 Connection). Create bucket "mmaxr-telemetry" ---
S3_ENDPOINT=https://PROJECTREF.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

REDIS_URL=redis://redis:6379
NODE_ENV=production
JWT_SECRET=generate-with-openssl-rand-hex-32
INTERNAL_API_KEY=generate-with-openssl-rand-hex-32
INSTRUCTOR_INVITE_CODE=choose-one
TOKEN_TTL=8h

# Service-to-service (inside the compose network)
OBJECT_STORE_URL=http://object-store:3006
SESSION_AUTH_URL=http://session-auth:3004
LESSON_LOADER_URL=http://lesson-loader:3007

# --- AI coach ---
AI_COACH_PROVIDER=gemini
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENAI_API_KEY=
AI_COACH_ALLOWED_ORIGINS=https://mmaxr.pages.dev
AI_COACH_REQUIRE_SESSION=true

# --- Later: self-hosted LRS on the spare laptop (reach it via Tailscale / Cloudflare Tunnel) ---
# LRS_URL=https://lrs.example.com/xapi

# --- 3D models (not in git). Pages project holds most; files >25 MB live in a public Supabase bucket ---
ASSET_BASE_URL=https://mmaxr-assets.pages.dev
ASSET_OVERRIDES=human-tooth.glb=https://PROJECTREF.supabase.co/storage/v1/object/public/mmaxr-models/models/human-tooth.glb,human-stomach.glb=https://PROJECTREF.supabase.co/storage/v1/object/public/mmaxr-models/models/human-stomach.glb
